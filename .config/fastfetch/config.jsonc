{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "$HOME/.config/fastfetch/ascii.txt",
        "padding": { "top": 5, "right": 2, "left": 2 },
        "color": { "1": "94" }
    },

    "display": {
        "separator": "  ",
        "key": { "width": 3 },
        // 1 (number) + 2 (bar) + 8 (monochrome bar): one accent-coloured bar
        // plus a threshold-coloured percentage.
        "percent": { "type": 11 },
        "bar": {
            "char": { "elapsed": "━", "total": "─" },
            "border": { "left": "", "right": "" },
            "width": 12
        },
        "size": { "ndigits": 1 },
        "constants": [
            "│ "
        ]
    },

    "modules": [
        "break",

        {
            "type": "title",
            "format": "{#1;94}{user-name}{#90}@{#1;94}{host-name}{#}"
        },
        { "type": "custom", "format": "{#90}╭──────────────────────────────{#}" },

        { "type": "os",       "key": "{$1}󰣇", "keyColor": "94", "format": "{pretty-name} {arch}" },
        { "type": "kernel",   "key": "{$1}󰌽", "keyColor": "94", "format": "{release}" },
        { "type": "packages", "key": "{$1}󰏖", "keyColor": "94" },
        { "type": "uptime",   "key": "{$1}󰅐", "keyColor": "94" },

        { "type": "custom", "format": "{#90}├─ {#94}desktop {#90}─────────────────────{#}" },

        { "type": "wm",           "key": "{$1}", "keyColor": "94", "format": "{pretty-name} ({protocol-name})" },
        { "type": "shell",        "key": "{$1}", "keyColor": "94", "format": "{pretty-name} {version}" },
        { "type": "terminal",     "key": "{$1}", "keyColor": "94", "format": "{pretty-name}" },
        { "type": "terminalfont", "key": "{$1}", "keyColor": "94", "format": "{name} {size}" },
        { "type": "display",      "key": "{$1}󰍹", "keyColor": "94", "format": "{width}x{height} @ {refresh-rate}Hz" },

        { "type": "custom", "format": "{#90}├─ {#94}hardware {#90}────────────────────{#}" },

        { "type": "cpu",     "key": "{$1}", "keyColor": "94", "format": "{name} ({cores-logical})" },
        { "type": "gpu",     "key": "{$1}󰢮", "keyColor": "94", "format": "{name}", "hideType": "integrated" },
        { "type": "memory",  "key": "{$1}", "keyColor": "94" },
        { "type": "swap",    "key": "{$1}󰓡", "keyColor": "94" },
        { "type": "disk",    "key": "{$1}󰋊", "keyColor": "94", "folders": "/",
          "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage})" },
        { "type": "battery", "key": "{$1}󰁹", "keyColor": "94", "format": "{capacity} [{status}]" },

        { "type": "custom", "format": "{#90}╰──────────────────────────────{#}" },

        "break",

        { "type": "colors", "symbol": "circle", "paddingLeft": 6 },

        "break"
    ]
}
