def kde_colour_groups(c):
    """[Colors:*] and [WM], as Plasma writes them when a scheme is applied."""
    def rgb(h):
        return ",".join(str(round(x * 255)) for x in _rgb(h))

    def group(bg, alt, fg, inactive=None, **extra):
        keys = {
            "BackgroundNormal": bg, "BackgroundAlternate": alt,
            "ForegroundNormal": fg, "ForegroundInactive": inactive or c["muted"],
            "ForegroundActive": c["accent_hover"], "ForegroundLink": c["link"],
            "ForegroundVisited": c["visited"], "ForegroundNegative": c["negative"],
            "ForegroundNeutral": c["neutral"], "ForegroundPositive": c["positive"],
            "DecorationFocus": c["accent"], "DecorationHover": c["accent_hover"],
        }
        keys.update(extra)
        return {k: rgb(v) for k, v in keys.items()}

    return {
        "Colors:Window": group(c["window"], c["alt_base"], c["text"]),
        "Colors:View": group(c["base"], c["alt_base"], c["text"]),
        "Colors:Button": group(c["button"], c["raised"], c["text"]),
        "Colors:Selection": group(c["accent"], c["accent_deep"], c["on_accent"], c["on_accent"],
                                  ForegroundActive=c["on_accent"], ForegroundLink=c["on_accent"],
                                  ForegroundVisited=c["on_accent"]),
        "Colors:Tooltip": group(c["raised"], c["button"], c["text"]),
        "Colors:Complementary": group(c["raised"], c["button"], c["text"]),
        "Colors:Header": group(c["button"], c["window"], c["text"]),
        "Colors:Header][Inactive": group(c["window"], c["base"], c["muted"]),
        "WM": {
            "activeBackground": rgb(c["button"]), "activeForeground": rgb(c["text"]),
            "activeBlend": rgb(c["text"]),
            "inactiveBackground": rgb(c["window"]), "inactiveForeground": rgb(c["muted"]),
            "inactiveBlend": rgb(c["muted"]),
        },
    }


# What the stowed kdeglobals used to carry, now that the file is written here
# (KDE apps write their own settings into it, which landed in the clone). Set
# only where missing, so a later change by an app or the user is kept.
KDEGLOBALS_SEED = {
    "General": {"TerminalApplication": "alacritty"},
    "Icons": {"Theme": "breeze-dark"},
}


def ini_groups(text):
    """KConfig text as [(group or None, [lines])], the lines kept verbatim."""
    groups, name, lines = [], None, []
    for line in text.splitlines():
        head = re.fullmatch(r"\[(.+)\]", line.strip())
        if head:
            groups.append((name, lines))
            name, lines = head.group(1), []
        else:
            lines.append(line)
    groups.append((name, lines))
    return groups


def kdeglobals(text, c):
    """`text` with the colour groups replaced, [General] ColorScheme set, the
    seed keys added where missing, and everything else left as it was."""
    owned = kde_colour_groups(c)
    seeds = {g: dict(keys) for g, keys in KDEGLOBALS_SEED.items()}
    seeds.setdefault("General", {})
    out = []

    def emit(name, lines):
        out.append(f"[{name}]")
        out.extend(lines)
        out.append("")

    for name, lines in ini_groups(text):
        if name in owned:
            continue
        if name is None:
            lines = [x for x in lines if x.strip()]
            if lines:
                out.extend(lines + [""])
            continue
        keys = [x.split("=", 1)[0].strip() for x in lines if "=" in x]
        if name == "General":
            lines = [x for x in lines if x.split("=", 1)[0].strip() != "ColorScheme"]
        # the scheme Dolphin was told to use in the old stowed file; there is
        # no such scheme, and these colours replace it
        if name == "UiSettings":
            lines = [x for x in lines if x.strip() != "ColorScheme=KvGlass"]
        while lines and not lines[-1].strip():
            lines.pop()
        if name == "General":
            lines.append("ColorScheme=SimplyChit")
        lines.extend(f"{k}={v}" for k, v in seeds.pop(name, {}).items() if k not in keys)
        if any(x.strip() for x in lines):
            emit(name, lines)
    for name, seed in seeds.items():
        emit(name, (["ColorScheme=SimplyChit"] if name == "General" else [])
             + [f"{k}={v}" for k, v in seed.items()])
    for name, keys in owned.items():
        emit(name, [f"{k}={v}" for k, v in keys.items()])
    return "\n".join(out)


def kde_scheme(c):
    """The same groups as a colour scheme file, for apps that pick one by name
    (Dolphin's Settings > Window Color Scheme)."""
    out = ["# GENERATED by `simplychit sync-palette`; rewritten on every wallpaper change.",
           "[General]", "Name=SimplyChit", "ColorScheme=SimplyChit", ""]
    for name, keys in kde_colour_groups(c).items():
        out.append(f"[{name}]")
        out.extend(f"{k}={v}" for k, v in keys.items())
        out.append("")
    return "\n".join(out)


def inside_repo(path):
    return os.path.realpath(path).startswith(os.path.realpath(REPO_HOME) + os.sep)


# Qt's icon theme (qt5ct/qt6ct icon_theme=SimplyChit). breeze-dark lacks the
# "-symbolic" names tray menus ask for (blueman's bluetooth-symbolic), and Qt,
# unlike GTK, does not drop the suffix to find another. Adwaita has them, but
# drawn in a fixed dark grey that GTK recolours and Qt does not: dark on a
# dark menu. So this theme holds Adwaita's symbolic icons that breeze has no
# icon for, the greys turned into the palette's text colour (its accents,
# green or red, kept), and inherits breeze-dark for everything else. Written
# again only when the text colour changes. GTK keeps breeze-dark: flatpaks
# cannot see ~/.local/share/icons.

ADWAITA_SYMBOLIC = "/usr/share/icons/Adwaita/symbolic"
ICON_GREYS = re.compile(r"#(?:2e343[46]|474747|bebebe|222(?![0-9a-fA-F])|000(?![0-9a-fA-F]))\b")


def sync_icons(c, done, failed):
    data = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
    theme = os.path.join(data, "icons", "SimplyChit")
    # stowed for a while before it was generated: a link into the clone to a
    # folder the repo no longer has, so nothing of the user's is in it
    if os.path.islink(theme) and inside_repo(theme) and not os.path.exists(theme):
        os.remove(theme)
    if inside_repo(theme):
        failed.append(f"{theme}: a link into the clone; run install.sh")
        return
    colour = c["text"]
    marker = os.path.join(theme, ".colour")
    try:
        with open(marker, encoding="utf-8") as f:
            if f.read().strip() == colour and os.path.isfile(os.path.join(theme, "index.theme")):
                return
    except OSError:
        pass

    breeze = set()
    for root_dir in ("/usr/share/icons/breeze-dark", "/usr/share/icons/breeze"):
        for _, _, files in os.walk(root_dir):
            breeze.update(f.rsplit(".", 1)[0] for f in files)

    try:
        if os.path.isdir(os.path.join(theme, "symbolic")):
            shutil.rmtree(os.path.join(theme, "symbolic"))
        contexts = []
        if os.path.isdir(ADWAITA_SYMBOLIC):
            for context in sorted(os.listdir(ADWAITA_SYMBOLIC)):
                src = os.path.join(ADWAITA_SYMBOLIC, context)
                if not os.path.isdir(src):
                    continue
                wrote = False
                for name in os.listdir(src):
                    if not name.endswith(".svg") or name[:-4] in breeze:
                        continue
                    with open(os.path.join(src, name), encoding="utf-8") as f:
                        svg = ICON_GREYS.sub(colour, f.read())
                    os.makedirs(os.path.join(theme, "symbolic", context), exist_ok=True)
                    with open(os.path.join(theme, "symbolic", context, name), "w", encoding="utf-8") as f:
                        f.write(svg)
                    wrote = True
                if wrote:
                    contexts.append(context)
        lines = ["# GENERATED by `simplychit sync-palette`; rewritten when the text colour changes.",
                 "[Icon Theme]", "Name=SimplyChit",
                 "Comment=breeze-dark, with Adwaita's symbolic icons it lacks in the palette's colour",
                 "Inherits=breeze-dark,Adwaita,hicolor",
                 "Directories=" + ",".join("symbolic/" + ctx for ctx in contexts), ""]
        for ctx in contexts:
            lines += [f"[symbolic/{ctx}]", "Size=16", "MinSize=8", "MaxSize=512", "Type=Scalable",
                      "Context=" + ctx.capitalize(), ""]
        write_atomic(os.path.join(theme, "index.theme"), "\n".join(lines))
        write_atomic(marker, colour + "\n")
        done.append(theme)
    except OSError as e:
        failed.append(f"{theme}: {e.strerror or e}")


def sync_qt(palette, done, failed):
    c = qt_colours(palette)
    sync_icons(c, done, failed)

    kv = os.path.join(HOME, ".config/Kvantum")
    if inside_repo(kv):
        # folded by stow into one link to the clone, so the theme would be
        # written into the repo; install.sh makes it a real folder
        failed.append(f"{kv}/SimplyChit: ~/.config/Kvantum is a link into the clone; "
                      "run install.sh to make it a folder")
    else:
        try:
            for name, text in (("SimplyChit.kvconfig", kvantum_config(c)), ("SimplyChit.svg", kvantum_svg(c))):
                dst = os.path.join(kv, "SimplyChit", name)
                write_atomic(dst, text)
                done.append(dst)
        except OSError as e:
            failed.append(f"{kv}/SimplyChit: {e.strerror or e}")
        # Which theme Kvantum uses. A real file, not a stowed link: a flatpak
        # sees ~/.config/Kvantum mounted inside its own config folder, where a
        # relative link into the clone points at nothing, and Kvantum then
        # falls back to its grey built-in theme. Written when missing or still
        # a link; a real file is the user's choice (Kvantum Manager) and kept.
        chooser = os.path.join(kv, "kvantum.kvconfig")
        if os.path.islink(chooser) or not os.path.exists(chooser):
            try:
                write_atomic(chooser, "[General]\ntheme=SimplyChit\n")
                done.append(chooser)
            except OSError as e:
                failed.append(f"{chooser}: {e.strerror or e}")

    data = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
    scheme = os.path.join(data, "color-schemes", "SimplyChit.colors")
    try:
        write_atomic(scheme, kde_scheme(c))
        done.append(scheme)
    except OSError as e:
        failed.append(f"{scheme}: {e.strerror or e}")

    # kdeglobals was stowed until the colours went in; a link still pointing
    # at the clone (dangling once the repo dropped the file) is read if it can
    # be, and the rename replaces the link with a real file
    path = os.path.join(HOME, ".config/kdeglobals")
    try:
        try:
            with open(path, encoding="utf-8") as f:
                old = f.read()
        except FileNotFoundError:
            old = ""
        write_atomic(path, kdeglobals(old, c))
        done.append(path)
    except OSError as e:
        failed.append(f"{path}: {e.strerror or e}")


def read_palette(cache):
    try:
        with open(os.path.join(cache, "colors.json"), encoding="utf-8") as f:
            data = json.load(f)
        return dict(data.get("colors", {}), **data.get("special", {}))
    except (OSError, ValueError, AttributeError, TypeError):
        return {}


def sync_palette():
    """pywal16 renders into ~/.cache/wal; these are the consumers that cannot
    read from there and keep a copy. Each is skipped when it is not installed.
    The shell (services/Theme.qml) runs this after every wal; install.sh runs it
    on install and update."""
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "wal")
    done, failed = [], []

    def copy(src, dst):
        # one consumer failing (a read-only or dangling link) must not stop
        # the others
        try:
            shutil.copyfile(src, dst)
            done.append(dst)
        except OSError as e:
            failed.append(f"{dst}: {e.strerror or e}")

    # hyprlock first: always written, defaults when there is no palette yet, so
    # the file hyprlock.conf sources exists from the first install on
    palette = read_palette(cache)
    hyprlock = os.path.join(HOME, ".local/state/simplychit/hyprlock-colors.conf")
    try:
        write_atomic(hyprlock, hyprlock_colours(palette))
        done.append(hyprlock)
    except OSError as e:
        failed.append(f"{hyprlock}: {e.strerror or e}")

    # GTK: CSS cannot import from the cache. Three copies, not two: GTK resolves
    # a nested @import against the entry file's directory, so the GTK 4 sheet
    # reached through ~/.config/gtk-4.0/gtk.css looks for its palette there.
    gtk = os.path.join(cache, "colors-gtk.css")
    if os.path.isfile(gtk):
        for dst in (
            os.path.join(HOME, ".themes/simplychit/gtk-3.0/colors.css"),
            os.path.join(HOME, ".themes/simplychit/gtk-4.0/colors.css"),
            os.path.join(HOME, ".config/gtk-4.0/colors.css"),
        ):
            # the parent is stowed; a partial install may not have it
            if os.path.isdir(os.path.dirname(dst)):
                copy(gtk, dst)

    # btop: pywal16 renders btopwal.theme itself; btop only reads themes from
    # its own folder (color_theme = "simplychit" in btop.conf)
    btop = os.path.join(cache, "btopwal.theme")
    if shutil.which("btop") and os.path.isfile(btop):
        dst = os.path.join(HOME, ".config/btop/themes/simplychit.theme")
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            copy(btop, dst)
        except OSError as e:
            failed.append(f"{dst}: {e.strerror or e}")

    # VS Code reloads the active theme when its file changes, so an open window
    # follows the wallpaper. Written even before pywal16 has run (defaults),
    # like hyprlock's, so the theme is never missing its colours.
    #
    # Rewritten in place, not through write_atomic: VS Code reloads the theme
    # only on an *update* event for that file, and replacing it by rename
    # arrives as delete + add, which it ignores. The window then kept the old
    # colours until a restart. wal-theme writes in place for the same reason.
    theme = json.dumps(vscode_theme(palette), indent=2) + "\n"
    for dst in vscode_theme_paths():
        try:
            with open(dst, "w", encoding="utf-8") as f:
                f.write(theme)
            done.append(dst)
        except OSError as e:
            failed.append(f"{dst}: {e.strerror or e}")

    # Qt and KDE apps: the generated Kvantum theme and kdeglobals' colours
    sync_qt(palette, done, failed)

    # the browser, through the pywalfox add-on (it reads colors.json itself)
    if shutil.which("pywalfox"):
        if run("pywalfox", "update", timeout=10) is not None:
            done.append("pywalfox")

    for d in done:
        print(d.replace(HOME, "~"))
    for f in failed:
        print("not copied: " + f.replace(HOME, "~"), file=sys.stderr)
    return 1 if failed else 0


# ── inhibitors ──────────────────────────────────────────────────────────────
#
# The shell's idle steps (services/IdleTimers.qml) only see Wayland idle
# inhibitors. Browsers and most players ask over D-Bus instead, at
# org.freedesktop.ScreenSaver (directly, or through the portal, which forwards
# there), and some tools take a logind "idle" inhibitor. This service owns the
# ScreenSaver name, watches logind, and keeps the current list in
# $XDG_RUNTIME_DIR/simplychit-inhibitors.json for the shell (services/Idle.qml).
# Event-driven: nothing runs between requests.

SCREENSAVER_XML = """<node>
  <interface name="org.freedesktop.ScreenSaver">
    <method name="Inhibit">
      <arg name="application_name" type="s" direction="in"/>
      <arg name="reason_for_inhibit" type="s" direction="in"/>
      <arg name="cookie" type="u" direction="out"/>
    </method>
    <method name="UnInhibit"><arg name="cookie" type="u" direction="in"/></method>
    <method name="GetActive"><arg type="b" direction="out"/></method>
    <method name="SimulateUserActivity"/>
  </interface>
</node>"""


def inhibitors():
    import fcntl
    import signal

    from gi.repository import Gio, GLib

    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    out_path = os.path.join(runtime, "simplychit-inhibitors.json")

    # One at a time: D-Bus activation and the login start may both run it.
    lock = open(os.path.join(runtime, "simplychit-inhibitors.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0

    cookies = {}       # cookie -> (sender, app, reason)
    watches = {}       # sender -> NameOwnerChanged subscription id
    from_logind = []   # [(who, why)]
    state = {"next": 0, "written": None}
    session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    try:
        system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except GLib.Error:
        system = None

    def publish():
        rows = [{"app": app, "reason": reason, "via": "dbus"} for _, app, reason in cookies.values()]
        rows += [{"app": who, "reason": why, "via": "logind"} for who, why in from_logind]
        text = json.dumps(rows, ensure_ascii=False)
        if text == state["written"]:
            return
        state["written"] = text
        if rows:
            write_atomic(out_path, text + "\n")
        elif os.path.exists(out_path):
            os.remove(out_path)

    def sender_gone(conn, sender_name, path, iface, signal_name, params, sender):
        _, _, new_owner = params.unpack()
        if new_owner:
            return
        for cookie in [c for c, v in cookies.items() if v[0] == sender]:
            del cookies[cookie]
        session.signal_unsubscribe(watches.pop(sender))
        publish()

    def watch(sender):
        if sender not in watches:
            watches[sender] = session.signal_subscribe(
                "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                "/org/freedesktop/DBus", sender, Gio.DBusSignalFlags.NONE, sender_gone, sender)

    def call(conn, sender, path, iface, method, params, invocation):
        if method == "Inhibit":
            app, reason = params.unpack()
            state["next"] += 1
            cookies[state["next"]] = (sender, app, reason)
            watch(sender)
            invocation.return_value(GLib.Variant("(u)", (state["next"],)))
            publish()
        elif method == "UnInhibit":
            (cookie,) = params.unpack()
            cookies.pop(cookie, None)
            if sender in watches and not any(v[0] == sender for v in cookies.values()):
                session.signal_unsubscribe(watches.pop(sender))
            invocation.return_value(None)
            publish()
        elif method == "GetActive":
            invocation.return_value(GLib.Variant("(b)", (False,)))
        else:
            invocation.return_value(None)

    info = Gio.DBusNodeInfo.new_for_xml(SCREENSAVER_XML).interfaces[0]
    for path in ("/org/freedesktop/ScreenSaver", "/ScreenSaver"):
        session.register_object(path, info, call, None, None)
    # Queued, not refused, while someone else (an old hypridle) holds the name:
    # it is ours as soon as they let go.
    Gio.bus_own_name_on_connection(session, "org.freedesktop.ScreenSaver",
                                   Gio.BusNameOwnerFlags.NONE, None, None)

    def logind_listed(conn, result):
        try:
            (rows,) = conn.call_finish(result).unpack()
        except GLib.Error:
            return
        from_logind[:] = [(who, why) for what, who, why, mode, uid, pid in rows
                          if "idle" in what.split(":") and mode == "block" and who != "simplychit"]
        publish()

    def logind_refresh(*_):
        system.call("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                    "ListInhibitors", None, GLib.VariantType("(a(ssssuu))"), Gio.DBusCallFlags.NONE, 3000,
                    None, logind_listed)

    def logind_changed(conn, sender, path, iface, signal_name, params, _):
        _, changed, invalidated = params.unpack()
        if "BlockInhibited" in changed or "BlockInhibited" in invalidated:
            logind_refresh()

    if system is not None:
        system.signal_subscribe("org.freedesktop.login1", "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                                Gio.DBusSignalFlags.NONE, logind_changed, None)
        logind_refresh()

    loop = GLib.MainLoop()
    try:
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except ImportError:  # PyGObject before 3.52
        signal_add = GLib.unix_signal_add
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal_add(GLib.PRIORITY_DEFAULT, sig, lambda *_: loop.quit() or False)
    publish()
    loop.run()
    if os.path.exists(out_path):
        os.remove(out_path)
    return 0


# ── privacy ─────────────────────────────────────────────────────────────────
#
# The shell sees microphone, screen-share and PipeWire camera streams in
# PipeWire itself (services/Privacy.qml). An app that opens /dev/video*
# directly (Zoom, Discord, OBS) never shows up there, so this watches the
# device nodes with inotify (no polling, no package): on any open or close it
# looks for the processes holding one and prints the list when it changed.
# PipeWire's own processes are left out; they hold the camera on behalf of
# the streams the shell already sees.

PRIVACY_IGNORE = {"pipewire", "wireplumber", "pipewire-pulse", "pipewire-media-session"}


def camera_users():
    users = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue  # gone, or another user's
        for fd in fds:
            try:
                target = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if target.startswith("/dev/video"):
                try:
                    with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
                        name = f.read().strip()
                except OSError:
                    name = pid
                if name not in PRIVACY_IGNORE:
                    users[int(pid)] = name
                break
    return [{"pid": pid, "app": name} for pid, name in sorted(users.items())]


def privacy_watch():
    import ctypes
    import select
    import signal
    import struct
    import time

    libc = ctypes.CDLL(None, use_errno=True)
    IN_OPEN, IN_CLOSE_WRITE, IN_CLOSE_NOWRITE = 0x20, 0x08, 0x10
    IN_CREATE, IN_DELETE = 0x100, 0x200
    fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
    if fd < 0:
        print(f"simplychit: inotify: {os.strerror(ctypes.get_errno())}", file=sys.stderr)
        return 1
    watched = set()

    def watch_devices():
        for name in os.listdir("/dev"):
            if name.startswith("video") and name not in watched:
                if libc.inotify_add_watch(fd, f"/dev/{name}".encode(), IN_OPEN | IN_CLOSE_WRITE | IN_CLOSE_NOWRITE) >= 0:
                    watched.add(name)

    # /dev itself, for a camera plugged in later
    libc.inotify_add_watch(fd, b"/dev", IN_CREATE | IN_DELETE)
    watch_devices()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    last = None

    def report():
        nonlocal last
        now = camera_users()
        if now != last:
            last = now
            print(json.dumps({"camera": now}), flush=True)

    report()
    while True:
        select.select([fd], [], [])
        try:
            data = os.read(fd, 65536)
        except BlockingIOError:
            continue
        # a camera added or removed: watch the new node, forget a gone one
        offset = 0
        while offset < len(data):
            _, mask, _, length = struct.unpack_from("iIII", data, offset)
            name = data[offset + 16:offset + 16 + length].rstrip(b"\0").decode(errors="replace")
            offset += 16 + length
            if mask & IN_DELETE:
                watched.discard(name)
        watch_devices()
        # an open is seen before the app has finished setting the camera up,
        # and several opens come at once: let them settle
        time.sleep(0.3)
        try:
            while os.read(fd, 65536):
                pass
        except BlockingIOError:
            pass
        report()


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if args[0] == "doctor":
        return doctor("--json" in args)
    if args[0] == "check-settings":
        return check_settings("--json" in args)
    if args[0] == "events":
        return events(args[1:])
    if args[0] == "sync-palette":
        return sync_palette()
    if args[0] == "vscode-theme":
        cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "wal")
        if len(args) == 3 and args[1] == "--vsix":
            return build_vsix(args[2], read_palette(cache))
        print(json.dumps(vscode_theme(read_palette(cache)), indent=2))
        return 0
    if args[0] == "inhibitors":
        return inhibitors()
    if args[0] == "privacy-watch":
        return privacy_watch()
    print(f"simplychit: unknown command {args[0]!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
