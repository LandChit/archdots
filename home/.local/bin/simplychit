#!/usr/bin/env python3
"""simplychit — small command-line helpers for these dotfiles.

    simplychit doctor [--json]          check that everything the desktop needs
                                      is there and running, and the config
    simplychit check-settings [--json]  check settings.json against its schema:
                                      unknown keys, wrong types, bad values
    simplychit events [YYYY-MM-DD]      one day's calendar events from khal, as
                                      JSON (today if no date)
    simplychit sync-palette             hand pywal16's palette to the apps that
                                      keep their own copy (GTK, Qt/Kvantum, KDE,
                                      hyprlock, btop, the browser, VS Code); run
                                      after every `wal`
    simplychit vscode-theme [--vsix F]  the VS Code colour theme for the current
                                      palette, as JSON; --vsix packs the
                                      extension into F (install.sh installs it)
    simplychit inhibitors               the service that hears apps asking the
                                      screen to stay awake (a video playing)
                                      and tells the shell; started at login
    simplychit privacy-watch            the apps holding a camera open, as a
                                      JSON line on start and on every change
                                      (the shell's privacy indicator runs it)

The settings app's About page shows the same checks (it runs --json).
"""

import datetime
import difflib
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
SETTINGS = os.path.join(HOME, ".config/simplychit/settings.json")
HYPR_LOG = os.path.join(HOME, ".cache/hypr-custom.log")
# This script is stowed from <repo>/home/.local/bin/, so the repo is three up.
REPO_HOME = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
# Generated from Config.qml (tools/gen-settings-schema.py).
SCHEMA = os.path.join(REPO_HOME, ".config/quickshell/simplychit/config/settings.schema.json")


def run(*cmd, timeout=3):
    """stdout (or stderr, if that is where it printed) of a command, or None
    if it is missing, fails or hangs."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (out.stdout.strip() or out.stderr.strip()) if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def running(pattern):
    return run("pgrep", "-f", pattern) is not None


def checks():
    out = []

    def add(group, name, status, detail=""):
        out.append({"group": group, "name": name, "status": status, "detail": detail})

    # ── programs ────────────────────────────────────────────────────────────
    required = {
        "Hyprland": "the compositor", "qs": "the shell (quickshell)", "hypridle": "locking before sleep",
        "hyprlock": "the lock screen fallback", "wal": "colours from the wallpaper (python-pywal16)",
        "cliphist": "clipboard history", "wl-copy": "copying", "grim": "screenshots", "slurp": "region screenshots",
        "brightnessctl": "laptop brightness", "playerctl": "media keys", "wpctl": "volume keys",
        "upower": "battery state", "nmcli": "Wi-Fi (NetworkManager)",
    }
    optional = {
        "fd": "the launcher's file search", "ddcutil": "external monitor brightness",
        "tlp": "power profiles through tlp-pd", "bluetoothctl": "pairing devices that need a passkey",
        "khal": "events in the calendar panel", "wf-recorder": "screen recording",
        "qrencode": "the clipboard as a QR code", "zbarimg": "scanning QR codes (zbar)",
    }
    for cmd, why in required.items():
        add("Programs", cmd, "ok" if shutil.which(cmd) else "fail", why if shutil.which(cmd) else "missing: " + why)
    for cmd, why in optional.items():
        add("Programs", cmd, "ok" if shutil.which(cmd) else "warn", why if shutil.which(cmd) else "not installed (optional): " + why)

    # ── running ─────────────────────────────────────────────────────────────
    shell = run("qs", "list", "-c", "simplychit") or ""
    add("Running", "shell", "ok" if "Instance" in shell else "fail",
        "qs -c simplychit" if "Instance" in shell else "not running: SUPER+SHIFT+CTRL+ALT+R, or log in again")
    # the watchdog holds this lock while it runs (hypr/Scripts/shell-watchdog.sh)
    lock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "simplychit-shell.lock")
    watched = os.path.exists(lock) and run("flock", "-n", lock, "true") is None
    add("Running", "shell watchdog", "ok" if watched else "warn",
        "restarts the shell if it crashes" if watched else "not running: a crashed shell stays down until SUPER+SHIFT+CTRL+ALT+R")
    add("Running", "hypridle", "ok" if running("^hypridle") else "warn",
        "locks before sleep" if running("^hypridle") else "not running: the screen is not locked before suspend")
    add("Running", "clipboard watcher", "ok" if running("wl-paste --watch cliphist") else "warn",
        "wl-paste --watch cliphist store" if running("wl-paste --watch cliphist") else "not running: nothing new reaches the clipboard history")
    owner = run("busctl", "--user", "status", "org.freedesktop.Notifications") or ""
    pid = next((line.split("=", 1)[1] for line in owner.splitlines() if line.startswith("PID=")), "")
    comm = (run("ps", "-o", "comm=", "-p", pid) if pid else "") or ""
    if not pid:
        add("Running", "notifications", "fail", "nobody owns org.freedesktop.Notifications")
    elif comm in ("qs", "quickshell", ".quickshell-wra"):
        add("Running", "notifications", "ok", "the shell")
    elif comm.startswith("python"):
        add("Running", "notifications", "fail", "owned by the old fabric shell (python): run install.sh update")
    else:
        add("Running", "notifications", "fail", f"owned by {comm or pid}, so the shell's cards never show (dunst, mako, swaync?)")
    # where browsers ask to stay awake; the shell only hears it through this
    owner = run("busctl", "--user", "status", "org.freedesktop.ScreenSaver") or ""
    pid = next((line.split("=", 1)[1] for line in owner.splitlines() if line.startswith("PID=")), "")
    cmdline = ""
    if pid:
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmdline = f.read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            pass
    if "simplychit inhibitors" in cmdline:
        add("Running", "stay-awake requests", "ok", "simplychit inhibitors: videos in browsers keep the screen on")
    elif "hypridle" in cmdline:
        add("Running", "stay-awake requests", "warn", "hypridle holds org.freedesktop.ScreenSaver, so videos in browsers do not stop the dim: run install.sh update")
    elif pid:
        add("Running", "stay-awake requests", "warn", f"org.freedesktop.ScreenSaver is held by {cmdline.split(' ')[0] or pid}, not simplychit inhibitors")
    else:
        add("Running", "stay-awake requests", "ok", "started by the first app that asks")
    registered = run("qs", "-c", "simplychit", "ipc", "call", "polkit", "registered")
    if registered == "true":
        add("Running", "polkit agent", "ok", "the shell's")
    elif running("hyprpolkitagent"):
        add("Running", "polkit agent", "warn", "hyprpolkitagent (the fallback) has it, so the shell's dialog is unused")
    else:
        add("Running", "polkit agent", "fail", "none: authentication prompts cannot ask you")
    for unit in ("pipewire", "wireplumber"):
        state = run("systemctl", "--user", "is-active", unit)
        add("Running", unit, "ok" if state == "active" else "fail", state or "inactive")

    # ── config ──────────────────────────────────────────────────────────────
    if not os.path.exists(SETTINGS):
        add("Config", "settings.json", "ok", "not created yet (everything is default)")
    else:
        problems, error = settings_problems()
        if error:
            add("Config", "settings.json", "warn", f"could not check it: {error}")
        elif not problems:
            add("Config", "settings.json", "ok", "valid")
        elif problems[0].startswith("not valid JSON"):
            add("Config", "settings.json", "fail", problems[0])
        else:
            add("Config", "settings.json", "warn", f"{len(problems)} problem(s); `simplychit check-settings` lists them")
            for p in problems[:5]:
                add("Config", "  " + p.split(":")[0], "warn", p.split(":", 1)[1].strip())
    try:
        with open(HYPR_LOG, encoding="utf-8") as f:
            last = f.read().strip().splitlines()[-1:]
        add("Config", "Hyprland overrides", "warn" if last else "ok", last[0] if last else "no errors logged")
    except OSError:
        add("Config", "Hyprland overrides", "ok", "no errors logged")
    for path in (".config/hypr", ".config/quickshell/simplychit", ".zshrc"):
        full = os.path.join(HOME, path)
        real = os.path.realpath(full)
        if not os.path.exists(full):
            add("Config", "~/" + path, "fail", "missing: run install.sh (stow)")
        elif real.startswith(REPO_HOME + os.sep):
            add("Config", "~/" + path, "ok", "→ " + real.replace(HOME, "~"))
        else:
            add("Config", "~/" + path, "warn", "→ " + real.replace(HOME, "~") + ", not this repo's home/")

    # ── versions ────────────────────────────────────────────────────────────
    for name, cmd in (("Hyprland", ("hyprctl", "version", "-j")), ("quickshell", ("qs", "--version")), ("pywal16", ("wal", "-v"))):
        text = run(*cmd) or ""
        if name == "Hyprland" and text:
            try:
                text = json.loads(text).get("tag", text)
            except ValueError:
                pass
        add("Versions", name, "ok" if text else "warn", text.splitlines()[0] if text else "unknown")
    return out


# ── settings.json against its schema ────────────────────────────────────────
# Just the parts of JSON Schema the generated schema uses: type, properties,
# additionalProperties, items, enum, minimum, maximum, pattern.

KINDS = {
    "boolean": ("true or false", lambda v: isinstance(v, bool)),
    "integer": ("a whole number", lambda v: isinstance(v, int) and not isinstance(v, bool)),
    "number": ("a number", lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)),
    "string": ("text in quotes", lambda v: isinstance(v, str)),
    "array": ("a list [ ... ]", lambda v: isinstance(v, list)),
    "object": ("an object { ... }", lambda v: isinstance(v, dict)),
}


def validate(value, schema, path, problems):
    kind = schema.get("type")
    if kind and not KINDS[kind][1](value):
        problems.append(f"{path}: should be {KINDS[kind][0]}, not {json.dumps(value)}")
        return
    if "enum" in schema and value not in schema["enum"]:
        problems.append(f"{path}: {json.dumps(value)} is not one of " + ", ".join(json.dumps(e) for e in schema["enum"]))
    if "minimum" in schema and value < schema["minimum"]:
        problems.append(f"{path}: {value} is below the minimum, {schema['minimum']}")
    if "maximum" in schema and value > schema["maximum"]:
        problems.append(f"{path}: {value} is above the maximum, {schema['maximum']}")
    if "pattern" in schema and not re.search(schema["pattern"], value):
        problems.append(f"{path}: {json.dumps(value)} is not in the expected form (HH:MM)")
    if kind == "array" and "items" in schema:
        for i, item in enumerate(value):
            validate(item, schema["items"], f"{path}[{i}]", problems)
    if kind == "object":
        props = schema.get("properties", {})
        extra = schema.get("additionalProperties", True)
        for key, item in value.items():
            where = f"{path}.{key}" if path else key
            if key in props:
                validate(item, props[key], where, problems)
            elif extra is False:
                close = difflib.get_close_matches(key, props, n=1)
                problems.append(f"{where}: unknown key, ignored" + (f" (did you mean {close[0]}?)" if close else ""))
            elif isinstance(extra, dict):
                validate(item, extra, where, problems)


def settings_problems():
    """(problems, error): what is wrong with settings.json, or why it could
    not be checked at all."""
    if not os.path.exists(SETTINGS):
        return [], None
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            data = json.load(f)
    except ValueError as e:
        return [f"not valid JSON: {e}"], None
    try:
        with open(SCHEMA, encoding="utf-8") as f:
            schema = json.load(f)
    except (OSError, ValueError) as e:
        return [], f"schema not readable ({e})"
    problems = []
    validate(data, schema, "", problems)
    return problems, None


def check_settings(as_json):
    problems, error = settings_problems()
    if as_json:
        print(json.dumps({"problems": problems, "error": error}))
    elif error:
        print(f"could not check: {error}", file=sys.stderr)
    elif problems:
        print(f"{SETTINGS.replace(HOME, '~')}: {len(problems)} problem(s)")
        for p in problems:
            print(f"  {p}")
    else:
        print(f"{SETTINGS.replace(HOME, '~')}: fine")
    return 1 if problems else 0


def doctor(as_json):
    results = checks()
    if as_json:
        print(json.dumps(results))
        return 1 if any(r["status"] == "fail" for r in results) else 0
    marks = {"ok": "\033[32m✓\033[0m", "warn": "\033[33m!\033[0m", "fail": "\033[31m✗\033[0m"}
    group = None
    for r in results:
        if r["group"] != group:
            group = r["group"]
            print(f"\n{group}")
        print(f"  {marks[r['status']]} {r['name']:<30} {r['detail']}")
    fails = sum(r["status"] == "fail" for r in results)
    print(f"\n{fails} problem(s)" if fails else "\nall good")
    return 1 if fails else 0


def khal_dateformat():
    """khal parses a date only in the user's own [locale] dateformat, not ISO,
    so read that format with khal's own code (khal is Python, and the pacman
    package lives in the system site-packages). If this python3 cannot import
    it (a venv first on PATH), ask the interpreter khal itself runs on, from
    its shebang. ISO if neither works."""
    try:
        from khal.settings import get_config
        return get_config()["locale"]["dateformat"]
    except Exception:
        pass
    try:
        with open(shutil.which("khal"), encoding="utf-8") as f:
            interpreter = f.readline()[2:].split()
        code = 'from khal.settings import get_config; print(get_config()["locale"]["dateformat"])'
        out = subprocess.run(interpreter + ["-c", code], capture_output=True, text=True, timeout=10)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except (OSError, TypeError, subprocess.TimeoutExpired):
        pass
    return "%Y-%m-%d"


def events(args):
    """{"day", "available", "events", "error"}: available is false when khal is
    not installed or not set up, which the calendar shows as a hint, not an
    error. Events come in khal's order: all-day first, then by start."""
    result = {"day": None, "available": False, "events": [], "error": None}
    try:
        day = datetime.date.fromisoformat(args[0]) if args else datetime.date.today()
        result["day"] = day.isoformat()
    except ValueError:
        result["error"] = f"not a date: {args[0]!r} (YYYY-MM-DD)"
        print(json.dumps(result))
        return 2
    if not shutil.which("khal"):
        result["error"] = "khal is not installed"
        print(json.dumps(result))
        return 0
    fields = ["title", "start-time", "end-time", "all-day", "location", "calendar", "calendar-color"]
    # khal reads the date in the user's locale (it calls setlocale), and the
    # default dateformat is %x, so format it in the same locale; in the C
    # locale %x is MM/DD/YY, which khal on en_GB takes for another day
    try:
        import locale
        locale.setlocale(locale.LC_ALL, "")
    except Exception:
        pass
    cmd = ["khal", "list", "--once", day.strftime(khal_dateformat()), "1d"]
    for f in fields:
        cmd += ["--json", f]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        result["error"] = f"khal failed: {e}"
        print(json.dumps(result))
        return 1
    if out.returncode != 0:
        # no config file is the usual case, and khal says so on stderr
        lines = [l for l in out.stderr.splitlines() if l.strip()]
        result["error"] = lines[0].removeprefix("critical: ") if lines else f"khal exited with {out.returncode}"
        print(json.dumps(result))
        return 0
    result["available"] = True
    # one JSON array per day line; with --once and 1d there is at most one,
    # and none at all on an empty day
    for line in out.stdout.splitlines():
        line = line.strip()
        if line.startswith("["):
            for e in json.loads(line):
                result["events"].append({
                    "title": e.get("title", ""),
                    "start": e.get("start-time", ""),
                    "end": e.get("end-time", ""),
                    "allDay": e.get("all-day") == "True",
                    "location": e.get("location", ""),
                    "calendar": e.get("calendar", ""),
                    "color": e.get("calendar-color", ""),
                })
    print(json.dumps(result))
    return 0


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


# What hyprlock shows before pywal16 has ever run: the shell's own fallbacks
# (config/Colours.qml).
HYPRLOCK_DEFAULTS = {"background": "#080c14", "foreground": "#c1c2c4", "color4": "#483930", "color12": "#ac6c4a"}


def hyprlock_colours(palette):
    """hyprlang variables for hyprlock.conf, which sources this file after its
    own defaults. Written from colors.json rather than by a pywal16 template, so
    an update that has not re-run wal still has a file to source."""
    def hex_of(name):
        value = palette.get(name, HYPRLOCK_DEFAULTS[name])
        return value.lstrip("#") if re.fullmatch(r"#[0-9a-fA-F]{6}", value or "") else HYPRLOCK_DEFAULTS[name].lstrip("#")

    def mix(a, b, t):
        a, b = bytes.fromhex(a), bytes.fromhex(b)
        return "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(a, b))

    bg, fg, accent = hex_of("background"), hex_of("foreground"), hex_of("color4")
    return "\n".join([
        "# GENERATED by `simplychit sync-palette` from ~/.cache/wal/colors.json.",
        "# Rewritten on every wallpaper change; hyprlock.conf sources it.",
        f"$sc_background = rgb({bg})",
        f"$sc_foreground = rgb({fg})",
        f"$sc_accent = rgb({accent})",
        f"$sc_accent_bright = rgb({hex_of('color12')})",
        # the island surface, as the shell draws it
        f"$sc_surface = rgba({mix(bg, accent, 0.22)}e0)",
        "",
    ])


# ── VS Code ─────────────────────────────────────────────────────────────────
#
# The theme of the SimplyChit extension (repo vscode-theme/, installed by
# install.sh). wal-theme maps colours 1-6 straight onto keywords, constants and
# types, and with --cols16 dual those are the *dark* half: on a dim wallpaper
# they land at about 1.5:1 against the background and the code is unreadable.
# Here every syntax colour keeps its hue but is lightened until it clears a
# contrast floor, so any wallpaper gives readable code.

VSCODE_EXTENSION = "simplychit.simplychit-theme"
VSCODE_DEFAULTS = dict(HYPRLOCK_DEFAULTS, **{
    "color0": "#080c14", "color1": "#3d332d", "color2": "#4a392f", "color3": "#222a30",
    "color5": "#523f33", "color6": "#6d513c", "color7": "#8c9097", "color8": "#585f6b",
    "color9": "#a36645", "color10": "#ae6f4a", "color11": "#3f6f93", "color13": "#b37550",
    "color14": "#be8e69", "color15": "#c1c2c4",
})


def _rgb(hexc):
    return tuple(b / 255 for b in bytes.fromhex(hexc.lstrip("#")))


def _hex(rgb):
    return "#" + "".join(f"{round(min(max(c, 0), 1) * 255):02x}" for c in rgb)


def _luminance(hexc):
    def lin(c):
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(c) for c in _rgb(hexc))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((_luminance(a), _luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def readable(hexc, bg, target):
    """hexc with its hue and saturation, made lighter (darker, on a light
    background) in small steps until it reaches `target`:1 against bg."""
    import colorsys
    h, l, s = colorsys.rgb_to_hls(*_rgb(hexc))
    step = 0.01 if _luminance(bg) < 0.5 else -0.01
    out = hexc
    while contrast(out, bg) < target and 0 <= l <= 1:
        l += step
        out = _hex(colorsys.hls_to_rgb(h, min(max(l, 0), 1), s))
    return out


def mix(a, b, t):
    return _hex(tuple(x + (y - x) * t for x, y in zip(_rgb(a), _rgb(b))))


def vscode_theme(palette):
    def get(name):
        value = palette.get(name, "")
        return value if re.fullmatch(r"#[0-9a-fA-F]{6}", value or "") else VSCODE_DEFAULTS[name]

    bg, fg = get("background"), get("foreground")
    fg = readable(fg, bg, 9)

    def code(name, floor=5.5):
        return readable(get(name), bg, floor)

    comment = readable(get("color8"), bg, 4.2)    # quieter than code, still legible
    muted = readable(mix(fg, bg, 0.35), bg, 4.5)  # UI text that is not the focus
    accent = code("color12", 4.5)
    raised, overlay = mix(bg, fg, 0.05), mix(bg, fg, 0.09)
    border = mix(bg, fg, 0.16)

    # A wallpaper often gives one hue in four shades, and lightening each to the
    # same floor would make them one colour. So the roles also differ in
    # lightness, and two are tinted toward the foreground: that keeps strings,
    # functions, constants and properties apart on a near-monochrome palette.
    keyword, string, number = code("color11"), code("color10"), code("color14", 6.5)
    func, typ = code("color13", 7.5), code("color14", 7)
    constant = readable(mix(get("color11"), fg, 0.45), bg, 6.5)
    prop = readable(mix(get("color12"), fg, 0.5), bg, 7)
    tag, special = code("color13", 6), code("color6")
    error, warn, info = code("color9"), code("color13"), code("color11")

    def tok(scope, colour, style=None):
        settings = {"foreground": colour}
        if style is not None:
            settings["fontStyle"] = style
        return {"scope": scope, "settings": settings}

    return {
        "$schema": "vscode://schemas/color-theme",
        "name": "SimplyChit",
        "type": "dark" if _luminance(bg) < 0.5 else "light",
        "semanticHighlighting": True,
        "colors": {
            "foreground": fg, "descriptionForeground": muted, "disabledForeground": comment,
            "focusBorder": accent + "99", "widget.shadow": "#00000066",
            "selection.background": accent + "55", "icon.foreground": muted,
            "textLink.foreground": accent, "textLink.activeForeground": accent,
            "textPreformat.foreground": number, "textBlockQuote.background": raised,
            "button.background": accent, "button.foreground": bg, "button.hoverBackground": readable(accent, bg, 6),
            "button.secondaryBackground": overlay, "button.secondaryForeground": fg,
            "badge.background": accent, "badge.foreground": bg,
            "progressBar.background": accent,
            "dropdown.background": raised, "dropdown.border": border, "dropdown.foreground": fg,
            "input.background": raised, "input.border": border, "input.foreground": fg,
            "input.placeholderForeground": comment, "inputOption.activeBorder": accent,
            "inputValidation.errorBorder": error, "inputValidation.warningBorder": warn,
            "inputValidation.infoBorder": info,
            "scrollbarSlider.background": fg + "22", "scrollbarSlider.hoverBackground": fg + "44",
            "scrollbarSlider.activeBackground": fg + "66",
            "list.activeSelectionBackground": accent + "33", "list.activeSelectionForeground": fg,
            "list.inactiveSelectionBackground": overlay, "list.inactiveSelectionForeground": fg,
            "list.hoverBackground": raised, "list.hoverForeground": fg,
            "list.focusOutline": accent + "99", "list.highlightForeground": accent,
            "activityBar.background": bg, "activityBar.foreground": fg,
            "activityBar.inactiveForeground": comment, "activityBar.border": border,
            "activityBarBadge.background": accent, "activityBarBadge.foreground": bg,
            "activityBar.activeBorder": accent,
