def vscode_theme_paths():
    """themes/simplychit.json in every installed copy of the extension: VS Code
    keeps extensions in ~/.vscode, VSCodium and Code - OSS in ~/.vscode-oss."""
    import glob
    paths = []
    for root in (".vscode", ".vscode-oss"):
        pattern = os.path.join(HOME, root, "extensions", VSCODE_EXTENSION + "-*", "themes", "simplychit.json")
        paths.extend(glob.glob(pattern))
    return paths


VSIX_MANIFEST = """<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="{name}" Version="{version}" Publisher="{publisher}"/>
    <DisplayName>{display}</DisplayName>
    <Description xml:space="preserve">{description}</Description>
    <Categories>Themes</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Code.Engine" Value="{engine}"/>
    </Properties>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Code"/>
  </Installation>
  <Dependencies/>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/>
  </Assets>
</PackageManifest>
"""
VSIX_TYPES = """<?xml version="1.0" encoding="utf-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension=".json" ContentType="application/json"/><Default Extension=".vsixmanifest" ContentType="text/xml"/></Types>
"""


def build_vsix(out, palette):
    """Pack <repo>/vscode-theme/ with the current theme into a .vsix that
    `code --install-extension` takes. A theme needs no build step and no
    vsce: the package is a zip with a manifest beside the extension folder."""
    import html
    import zipfile
    with open(os.path.join(os.path.dirname(REPO_HOME), "vscode-theme", "package.json"), encoding="utf-8") as f:
        raw = f.read()
    pkg = json.loads(raw)
    esc = {k: html.escape(str(v)) for k, v in {
        "name": pkg["name"], "version": pkg["version"], "publisher": pkg["publisher"],
        "display": pkg.get("displayName", pkg["name"]), "description": pkg.get("description", ""),
        "engine": pkg["engines"]["vscode"]}.items()}
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", VSIX_TYPES)
        z.writestr("extension.vsixmanifest", VSIX_MANIFEST.format(**esc))
        z.writestr("extension/package.json", raw)
        z.writestr("extension/themes/simplychit.json", json.dumps(vscode_theme(palette), indent=2) + "\n")
    return 0


# ── Qt ──────────────────────────────────────────────────────────────────────
#
# Qt apps draw with Kvantum (qt6ct's style), and Kvantum ignores qt6ct's
# palette: every colour comes from the theme's kvconfig and SVG. So the theme,
# SimplyChit, is generated here from the palette: the kvconfig and an SVG of
# flat rounded shapes in the GTK theme's colours, drawn in code rather than
# kept as a hand-edited SVG. KDE apps also read [Colors:*] from kdeglobals
# (through KColorScheme) for what the Qt palette has no role for, so that is
# written too. Neither reloads live: a Qt app picks the new colours up when it
# restarts.


def qt_colours(palette):
    """The roles the GTK theme derives (gtk.css), opaque: same names, same
    mixes, with text pushed to a contrast floor like the VS Code theme."""
    def get(name):
        value = palette.get(name, "")
        return value if re.fullmatch(r"#[0-9a-fA-F]{6}", value or "") else VSCODE_DEFAULTS[name]

    bg, accent = get("background"), get("color4")
    window = mix(bg, accent, 0.10)
    c = {
        "window": window,
        "base": mix(bg, accent, 0.04),
        "alt_base": mix(bg, accent, 0.08),
        "button": mix(bg, accent, 0.22),
        "raised": mix(bg, accent, 0.30),
        "accent": accent,
    }
    fg = readable(get("foreground"), window, 9)
    c["text"] = fg
    c["muted"] = readable(mix(fg, window, 0.30), window, 4.5)
    c["disabled"] = readable(mix(fg, window, 0.55), window, 3)
    c["accent_hover"] = mix(accent, fg, 0.18)
    # focus borders: the accent made visible on a text field (3:1, the floor
    # for non-text UI), since a dark accent on a dark field is not
    c["accent_ring"] = readable(accent, c["base"], 3)
    c["link"] = readable(c["accent_hover"], c["base"], 4.5)
    c["visited"] = readable(mix(accent, get("color5"), 0.40), c["base"], 4.5)
    # text on a selection: the candidate that reads best on the accent. A
    # mid-tone accent (a hot pink) needs dark text, which pushing a light
    # colour lighter never reaches, so near-black and near-white are candidates
    # next to the palette's own.
    candidates = (get("color7"), fg, bg, mix(fg, "#ffffff", 0.7), mix(bg, "#000000", 0.7))
    on = max(candidates, key=lambda x: contrast(x, accent))
    c["on_accent"] = on
    # the pressed and unfocused selection: the accent moved away from its text
    # (darker under light text, lighter under dark), so it reads at least as well
    away = "#000000" if _luminance(on) > _luminance(accent) else "#ffffff"
    c["accent_deep"] = mix(accent, away, 0.25)
    c["light"], c["midlight"] = mix(window, fg, 0.22), mix(window, fg, 0.12)
    c["mid"], c["dark"] = mix(window, fg, 0.06), mix(bg, "#000000", 0.45)
    c["negative"] = readable("#d97f8c", c["base"], 4.5)
    c["neutral"] = readable("#d9b872", c["base"], 4.5)
    c["positive"] = readable("#7fb08a", c["base"], 4.5)
    return c


class _Svg:
    """A Kvantum SVG: every element is a <g id> drawn at its own spot in
    absolute coordinates (Kvantum renders an element by id into the widget's
    rectangle, so where it sits does not matter, only that it does not move
    with a transform). Each group starts with an invisible rect, so its bounds
    are exact even when what is drawn is thinner, like a border."""

    def __init__(self):
        self.out, self.x, self.y, self.row = [], 0, 0, 0

    def _place(self, w, h):
        if self.x + w > 1600:
            self.x, self.y, self.row = 0, self.y + self.row + 6, 0
        at = (self.x, self.y)
        self.x += w + 6
        self.row = max(self.row, h)
        return at

    def element(self, name, w, h, draw):
        """draw(x, y) returns the shapes for a w×h element at (x, y)."""
        x, y = self._place(w, h)
        self.out.append(f'<g id="{name}"><rect x="{x}" y="{y}" width="{w}" height="{h}" '
                        f'fill="#000000" fill-opacity="0"/>{draw(x, y)}</g>')

    def text(self):
        return ('<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="%d">\n'
                '<!-- GENERATED by `simplychit sync-palette`; rewritten on every wallpaper change -->\n'
                % (self.y + self.row + 6) + "\n".join(self.out) + "\n</svg>\n")


def _paint(colour, alpha=1.0):
    if colour is None or alpha <= 0:
        return None
    return f'fill="{colour}"' + (f' fill-opacity="{alpha:.2f}"' if alpha < 1 else "")


def _rect(x, y, w, h, paint):
    return f'<rect x="{x}" y="{y}" width="{w}" height="{h}" {paint}/>' if paint and w > 0 and h > 0 else ""


def _corner(x, y, s, r, inset, corner):
    """Path data for the part of an s×s corner square inside a rounded
    rectangle of radius r, its outer sides moved in by `inset`."""
    fx, fy = corner in ("tr", "br"), corner in ("bl", "br")

    def at(u, v):
        return f"{x + (s - u if fx else u):g},{y + (s - v if fy else v):g}"

    rr = r - inset
    d = f"M{at(inset, s)} "
    if rr > 0:
        sweep = 1 if fx == fy else 0
        d += f"L{at(inset, r)} A{rr:g},{rr:g} 0 0 {sweep} {at(r, inset)} "
    else:
        d += f"L{at(inset, inset)} "
    return d + f"L{at(s, inset)} L{at(s, s)} Z"


def _frame(svg, name, s, r, fill=None, fa=1.0, border=None, ba=1.0, bw=1, interior=True):
    """A 9-part frame: corners of size s with radius r, edges, interior.
    The border is a ring (even-odd), never under the fill, so a translucent
    fill does not show it through."""
    fp, bp = _paint(fill, fa), _paint(border, ba)
    bw = bw if bp else 0
    L = 8  # edges and the interior are stretched; any length works

    for corner in ("tl", "tr", "bl", "br"):
        def draw(x, y, corner=corner):
            out = ""
            if bp:
                out += (f'<path d="{_corner(x, y, s, r, 0, corner)} {_corner(x, y, s, r, bw, corner)}" '
                        f'fill-rule="evenodd" {bp}/>')
            if fp:
                out += f'<path d="{_corner(x, y, s, r, bw, corner)}" {fp}/>'
            return out
        part = {"tl": "topleft", "tr": "topright", "bl": "bottomleft", "br": "bottomright"}[corner]
        svg.element(f"{name}-{part}", s, s, draw)

    svg.element(f"{name}-top", L, s, lambda x, y: _rect(x, y, L, bw, bp) + _rect(x, y + bw, L, s - bw, fp))
    svg.element(f"{name}-bottom", L, s, lambda x, y: _rect(x, y + s - bw, L, bw, bp) + _rect(x, y, L, s - bw, fp))
    svg.element(f"{name}-left", s, L, lambda x, y: _rect(x, y, bw, L, bp) + _rect(x + bw, y, s - bw, L, fp))
    svg.element(f"{name}-right", s, L, lambda x, y: _rect(x + s - bw, y, bw, L, bp) + _rect(x, y, s - bw, L, fp))
    if interior:
        svg.element(name, L, L, lambda x, y: _rect(x, y, L, L, fp))


def _stroke(d, colour, width=2.0, alpha=1.0):
    return (f'<path d="{d}" fill="none" stroke="{colour}" stroke-width="{width:g}" '
            f'stroke-linecap="round" stroke-linejoin="round"'
            + (f' stroke-opacity="{alpha:.2f}"' if alpha < 1 else "") + "/>")


def _circle(cx, cy, r, paint):
    return f'<circle cx="{cx:g}" cy="{cy:g}" r="{r:g}" {paint}/>' if paint else ""


# Frame widths in pixels, each also the corner radius: small enough for dense
# KDE dialogs, round enough to sit next to the shell's islands.
KV_RADIUS = {"button": 6, "lineedit": 6, "menu": 8, "menuitem": 5, "itemview": 5,
             "tooltip": 6, "group": 8, "common": 6, "tframe": 8, "tab": 6,
             "progress": 4, "slider": 3, "scrollbarslider": 5, "dock": 6,
             "menubaritem": 5, "titlebar": 6}


# How opaque each surface is. Qt apps cannot be told apart the way GTK's CSS
# tells a sidebar from the content, so instead of picking which parts are
# glass, nearly everything is: the window at 0.80, views thin enough (0.30 on
# top of it, about 0.86 in all) that a list or Dolphin's file view is still
# glass rather than a solid slab, buttons 0.75, popups 0.85, text fields an
# accent wash. Hyprland blurs what shows through. Text stays opaque.
KV_ALPHA = {"window": 0.80, "button": 0.75, "view": 0.30, "popup": 0.85, "field": 0.10}

# Apps that paint their own video or canvas and break behind a translucent
# window (KvGlass's list).
KV_OPAQUE = ("kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,"
             "avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,"
             "trojita,dragon,digikam,obs,krita")


def kvantum_svg(c):
    """The SimplyChit Kvantum theme's SVG, drawn from the palette roles: flat,
    rounded, borders in the accent at the GTK theme's strength. Elements that
    are left out (arrows, MDI buttons) are drawn by Kvantum itself in the text
    colour."""
    svg = _Svg()
    accent, deep, text, on = c["accent"], c["accent_deep"], c["text"], c["on_accent"]
    hover = mix(c["button"], text, 0.14)
    R, A = KV_RADIUS, KV_ALPHA

    def frame(element, state, **kw):
        _frame(svg, f"{element}-{state}", R[element], R[element], **kw)

    # buttons, combo boxes, tool buttons (flat ones draw only from hover on)
    frame("button", "normal", fill=c["button"], fa=A["button"], border=accent, ba=0.28)
    frame("button", "focused", fill=hover, fa=A["button"], border=accent, ba=0.45)
    frame("button", "pressed", fill=deep, border=accent, ba=0.6)
    frame("button", "toggled", fill=accent, border=accent)
    frame("button", "disabled", fill=c["button"], fa=A["button"] / 2, border=accent, ba=0.14)
    # tabs: flat until hovered, the current one raised like a button
    frame("tab", "normal", fill=None)
    frame("tab", "focused", fill=accent, fa=0.14)
    frame("tab", "toggled", fill=c["button"], fa=A["button"], border=accent, ba=0.28)
    frame("tab", "pressed", fill=c["button"], fa=A["button"], border=accent, ba=0.45)
    frame("tframe", "normal", border=accent, ba=0.22, interior=False)
    # text fields; keyboard focus shows as a full-strength accent border
    frame("lineedit", "normal", fill=accent, fa=A["field"], border=accent, ba=0.28)
    frame("lineedit", "focused", fill=accent, fa=A["field"], border=c["accent_ring"])
    frame("lineedit", "disabled", fill=accent, fa=A["field"] / 2, border=accent, ba=0.14)
    # lists and trees: a wash on hover, the accent for the selection
    frame("itemview", "focused", fill=accent, fa=0.16)
    frame("itemview", "pressed", fill=deep)
    frame("itemview", "toggled", fill=accent)
    # menus and tooltips: the raised surface, like the shell's popups
    frame("menu", "normal", fill=c["raised"], fa=A["popup"], border=accent, ba=0.28)
    # a hovered menu item is drawn in the "toggled" state
    frame("menuitem", "focused", fill=accent)
    frame("menuitem", "toggled", fill=accent)
    frame("menuitem", "pressed", fill=deep)
    frame("menubaritem", "focused", fill=accent, fa=0.16)
    frame("menubaritem", "pressed", fill=accent)
    frame("menubaritem", "toggled", fill=accent)
    frame("tooltip", "normal", fill=c["raised"], fa=A["popup"], border=accent, ba=0.28)
    # outlines
    frame("group", "normal", border=accent, ba=0.22, interior=False)
    frame("common", "normal", border=accent, ba=0.22, interior=False)
    frame("dock", "normal", border=accent, ba=0.22, interior=False)
    frame("titlebar", "normal", fill=c["button"], fa=A["button"])
    frame("titlebar", "focused", fill=c["raised"])
    # progress and slider grooves, filled with the accent
    groove = mix(c["window"], text, 0.12)
    frame("progress", "normal", fill=groove)
    frame("progress", "disabled", fill=groove, fa=0.5)
    _frame(svg, "progress-pattern-normal", R["progress"], R["progress"], fill=accent)
    _frame(svg, "progress-pattern-disabled", R["progress"], R["progress"], fill=accent, fa=0.4)
    frame("slider", "normal", fill=groove)
    frame("slider", "toggled", fill=accent)
    frame("slider", "disabled", fill=groove, fa=0.5)
    # scrollbars: a pill in the text colour, the groove left empty
    frame("scrollbarslider", "normal", fill=text, fa=0.30, interior=False)
    frame("scrollbarslider", "focused", fill=text, fa=0.50, interior=False)
    frame("scrollbarslider", "pressed", fill=accent, interior=False)
    # list and table headers
    svg.element("header-normal", 8, 8, lambda x, y: _rect(x, y, 8, 8, _paint(c["alt_base"])))
    svg.element("header-focused", 8, 8, lambda x, y: _rect(x, y, 8, 8, _paint(hover)))
    svg.element("header-pressed", 8, 8, lambda x, y: _rect(x, y, 8, 8, _paint(accent, 0.3)))

    # check boxes and radio buttons, 16 px (check_size)
    def box(fill, fa, border, ba, mark=None):
        def draw(x, y):
            out = ""
            if border:
                out += f'<rect x="{x}" y="{y}" width="16" height="16" rx="4" {_paint(border, ba)}/>'
            out += f'<rect x="{x + 1}" y="{y + 1}" width="14" height="14" rx="3" {_paint(fill, fa)}/>'
            if mark == "check":
                out += _stroke(f"M{x + 4},{y + 8.5} L{x + 7},{y + 11.5} L{x + 12},{y + 5}", on, 2)
            elif mark == "tri":
                out += _stroke(f"M{x + 4.5},{y + 8} L{x + 11.5},{y + 8}", on, 2)
            return out
        return draw

    def dot(fill, fa, border, ba, mark=False):
        def draw(x, y):
            out = _circle(x + 8, y + 8, 8, _paint(border, ba)) if border else ""
            out += _circle(x + 8, y + 8, 7, _paint(fill, fa))
            if mark:
                out += _circle(x + 8, y + 8, 3.5, _paint(on))
            return out
        return draw

    edge = mix(c["base"], text, 0.45)
    for kind, shape in (("checkbox", box), ("radio", dot)):
        svg.element(f"{kind}-normal", 16, 16, shape(c["base"], 1, edge, 1))
        svg.element(f"{kind}-focused", 16, 16, shape(c["base"], 1, c["accent_ring"], 1))
        svg.element(f"{kind}-pressed", 16, 16, shape(accent, 0.3, accent, 1))
        svg.element(f"{kind}-disabled", 16, 16, shape(c["base"], 0.5, edge, 0.5))
        marks = [("checked", "check" if kind == "checkbox" else True)]
        if kind == "checkbox":
            marks.append(("tristate", "tri"))
        for state, mark in marks:
            svg.element(f"{kind}-{state}-normal", 16, 16, shape(accent, 1, accent, 1, mark))
            svg.element(f"{kind}-{state}-focused", 16, 16, shape(c["accent_hover"], 1, c["accent_hover"], 1, mark))
            svg.element(f"{kind}-{state}-pressed", 16, 16, shape(deep, 1, deep, 1, mark))
            svg.element(f"{kind}-{state}-disabled", 16, 16, shape(accent, 0.4, accent, 0.4, mark))

    # the slider's handle, 18 px (slider_handle_width/length)
    for state, fill in (("normal", accent), ("focused", c["accent_hover"]), ("pressed", deep),
                        ("disabled", c["disabled"])):
        svg.element(f"slidercursor-{state}", 18, 18,
                    lambda x, y, fill=fill: _circle(x + 9, y + 9, 8, _paint(fill)))

    # arrows (combo boxes, spin boxes, tree expanders, menus): chevrons in the
    # text colour, or on the accent where the state is drawn on it
    chevron = ((2, 3.5), (5, 6.5), (8, 3.5))  # pointing down, in a 10 px box
    turn = {"down": lambda u, v: (u, v), "up": lambda u, v: (u, 10 - v),
            "right": lambda u, v: (v, u), "left": lambda u, v: (10 - v, u)}
    for direction, f in turn.items():
        for state, colour in (("normal", text), ("focused", text), ("pressed", on),
                              ("toggled", on), ("disabled", c["disabled"])):
            def draw(x, y, f=f, colour=colour):
                pts = [f(u, v) for u, v in chevron]
                return _stroke("M" + " L".join(f"{x + u:g},{y + v:g}" for u, v in pts), colour, 1.5)
            svg.element(f"arrow-{direction}-{state}", 10, 10, draw)
            # combo boxes ask for "carrow", tree expanders for "tree-plus"
            # (closed) and "tree-minus" (open); a tree's arrow sits beside the
            # selection, not on it, so it keeps the text colour
            for alias, wanted in (("carrow", "down"), ("tree-plus", "right"), ("tree-minus", "down")):
                if direction == wanted:
                    keep = alias.startswith("tree") and state in ("pressed", "toggled")
                    svg.element(f"{alias}-{state}", 10, 10,
                                (lambda x, y, f=f: draw(x, y, f, text)) if keep else draw)
    # no corner mark on the default button
    svg.element("button-default-indicator", 8, 8, lambda x, y: "")

    # tab close buttons
    for state, colour in (("normal", c["muted"]), ("focused", text), ("pressed", accent),
                          ("disabled", c["disabled"])):
        svg.element(f"tab-close-{state}", 16, 16,
                    lambda x, y, colour=colour: _stroke(
                        f"M{x + 4.5},{y + 4.5} L{x + 11.5},{y + 11.5} M{x + 11.5},{y + 4.5} L{x + 4.5},{y + 11.5}",
                        colour, 1.6))

    # grips: dots in the muted text colour
    def dots(points, colour, r=1.2):
        return lambda x, y: "".join(_circle(x + px, y + py, r, _paint(colour)) for px, py in points)

    for state, colour in (("normal", c["muted"]), ("focused", text), ("pressed", accent)):
        svg.element(f"splitter-grip-{state}", 16, 16, dots(((8, 4), (8, 8), (8, 12)), colour))
    for state, colour in (("normal", c["muted"]), ("focused", text)):
        svg.element(f"resize-grip-{state}", 16, 16,
                    dots(((12, 4), (8, 8), (12, 8), (4, 12), (8, 12), (12, 12)), colour))
    svg.element("toolbar-handle", 8, 16, dots(((4, 4), (4, 8), (4, 12)), c["muted"]))
    return svg.text()


def kvantum_config(c):
    """The SimplyChit kvconfig: KvSimplicity's layout (rounded tabs, inline
    spin arrows, thin progress bars) with the SVG's element names, and every
    text colour from the palette roles."""
    R, A = KV_RADIUS, KV_ALPHA
    t, muted, on = c["text"], c["muted"], c["on_accent"]

    def alpha(colour, a):
        return f"{colour}{round(a * 255):02x}"

    def frame(element):
        n = R[element]
        return {"frame.element": element, "frame.top": n, "frame.bottom": n,
                "frame.left": n, "frame.right": n}

    def colours(normal=t, focus=t, press=on, toggle=on):
        return {"text.normal.color": normal, "text.focus.color": focus,
                "text.press.color": press, "text.toggle.color": toggle}

    sections = {
        "%General": {
