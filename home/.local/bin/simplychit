            "scroll_width": 10, "scroll_arrows": "false", "scroll_min_extent": 50,
            "transient_scrollbar": "true", "slider_width": 6,
            "slider_handle_width": 18, "slider_handle_length": 18,
            "center_toolbar_handle": "true", "check_size": 16,
            "textless_progressbar": "false", "progressbar_thickness": 8,
            "menubar_mouse_tracking": "true", "toolbutton_style": 0,
            "click_behavior": 0, "translucent_windows": "true", "blurring": "false",
            # the window background only; text and controls stay opaque
            "reduce_window_opacity": round((1 - A["window"]) * 100), "reduce_menu_opacity": 0,
            "opaque": KV_OPAQUE,
            "popup_blurring": "false", "vertical_spin_indicators": "false",
            "fill_rubberband": "false", "merge_menubar_with_toolbar": "true",
            "small_icon_size": 16, "large_icon_size": 32, "button_icon_size": 16,
            "toolbar_icon_size": 16, "combo_as_lineedit": "false", "combo_menu": "true",
            "combo_focus_rect": "false", "groupbox_top_label": "true",
            "inline_spin_indicators": "true", "remove_extra_frames": "true",
            "joined_inactive_tabs": "false", "layout_spacing": 4, "layout_margin": 6,
            "submenu_overlap": 0, "tooltip_delay": -1, "animate_states": "true",
            "no_window_pattern": "true", "respect_DE": "true",
        },
        "GeneralColors": {
            "window.color": c["window"],
            "base.color": alpha(c["base"], A["view"]), "alt.base.color": alpha(c["alt_base"], A["view"]),
            "button.color": c["button"], "light.color": c["light"], "mid.light.color": c["midlight"],
            "dark.color": c["dark"], "mid.color": c["mid"],
            "highlight.color": c["accent"], "inactive.highlight.color": c["accent_deep"],
            "tooltip.base.color": c["raised"], "text.color": t,
            "window.text.color": t, "button.text.color": t,
            "disabled.text.color": c["disabled"], "tooltip.text.color": t,
            "highlight.text.color": on, "link.color": c["link"],
            "link.visited.color": c["visited"], "progress.indicator.text.color": t,
