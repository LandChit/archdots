            "text.margin.top": 3, "text.margin.bottom": 3, "text.margin.left": 6, "text.margin.right": 6,
            "text.iconspacing": 4, "text.shadow": 0, "frame.expansion": 0, **colours(),
        },
        "PanelButtonTool": {"inherits": "PanelButtonCommand"},
