            "iconless_pushbutton": "false", "iconless_menu": "false",
            "disabled_icon_opacity": 70, "normal_default_pushbutton": "true",
            "single_top_toolbar": "true", "tint_on_mouseover": 0,
            "transparent_arrow_button": "true", "no_selection_tint": "true",
            "centered_forms": "false", "middle_click_scroll": "false",
