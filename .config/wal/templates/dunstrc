[global]
    monitor = 1
    follow = none
    width = (200, 300)
    height = (0, 300)
    origin = top-right
    offset = (4, 28)
    scale = 0
    notification_limit = 0
    progress_bar = true
    progress_bar_height = 5
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 350
    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 10
    horizontal_padding = 8
    text_icon_padding = 10
    frame_width = 3
    frame_color = "{color1}"
    separator_color = "{color8}"
    sort = yes
    idle_threshold = 120
    font = Monospace 10
    line_height = 0
    markup = full
    format = "<b>%c%s</b>\n%b"
    alignment = center
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = yes
    icon_position = left
    min_icon_size = 0
    max_icon_size = 90
    icon_path = /usr/share/icons/Adwaita/16x16/mimetypes/:/usr/share/icons/breeze-dark/actions/
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = do_action
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "{color0}"
    foreground = "{color4}"
    timeout = 5

[urgency_normal]
    background = "{color0}"
    foreground = "{color1}"
    timeout = 10

[urgency_critical]
    background = "{color9}"
    foreground = "{foreground}"
    frame_color = "{color9}"
    timeout = 0
