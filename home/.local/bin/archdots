#!/usr/bin/env python3
"""archdots — small command-line helpers for these dotfiles.

    archdots doctor [--json]   check that everything the desktop needs is there
                               and running, and that the config parses

The settings app's About page shows the same checks (it runs --json).
"""

import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
SETTINGS = os.path.join(HOME, ".config/archdots/settings.json")
HYPR_LOG = os.path.join(HOME, ".cache/hypr-custom.log")
# This script is stowed from <repo>/home/.local/bin/, so the repo is three up.
REPO_HOME = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))


def run(*cmd, timeout=3):
    """stdout (or stderr, if that is where it printed) of a command, or None
    if it is missing, fails or hangs."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (out.stdout.strip() or out.stderr.strip()) if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def running(pattern):
    return run("pgrep", "-f", pattern) is not None


def checks():
    out = []

    def add(group, name, status, detail=""):
        out.append({"group": group, "name": name, "status": status, "detail": detail})

    # ── programs ────────────────────────────────────────────────────────────
    required = {
        "Hyprland": "the compositor", "qs": "the shell (quickshell)", "hypridle": "locking before sleep",
        "hyprlock": "the lock screen fallback", "wal": "colours from the wallpaper (python-pywal16)",
        "cliphist": "clipboard history", "wl-copy": "copying", "grim": "screenshots", "slurp": "region screenshots",
        "brightnessctl": "laptop brightness", "playerctl": "media keys", "wpctl": "volume keys",
        "upower": "battery state", "nmcli": "Wi-Fi (NetworkManager)",
    }
    optional = {
        "fd": "the launcher's file search", "ddcutil": "external monitor brightness",
        "tlp": "power profiles through tlp-pd", "bluetoothctl": "pairing devices that need a passkey",
    }
    for cmd, why in required.items():
        add("Programs", cmd, "ok" if shutil.which(cmd) else "fail", why if shutil.which(cmd) else "missing: " + why)
    for cmd, why in optional.items():
        add("Programs", cmd, "ok" if shutil.which(cmd) else "warn", why if shutil.which(cmd) else "not installed (optional): " + why)

    # ── running ─────────────────────────────────────────────────────────────
    shell = run("qs", "list", "-c", "archdots") or ""
    add("Running", "shell", "ok" if "Instance" in shell else "fail",
        "qs -c archdots" if "Instance" in shell else "not running: SUPER+SHIFT+CTRL+ALT+R, or log in again")
    add("Running", "hypridle", "ok" if running("^hypridle") else "warn",
        "locks before sleep" if running("^hypridle") else "not running: the screen is not locked before suspend")
    add("Running", "clipboard watcher", "ok" if running("wl-paste --watch cliphist") else "warn",
        "wl-paste --watch cliphist store" if running("wl-paste --watch cliphist") else "not running: nothing new reaches the clipboard history")
    owner = run("busctl", "--user", "status", "org.freedesktop.Notifications") or ""
    pid = next((line.split("=", 1)[1] for line in owner.splitlines() if line.startswith("PID=")), "")
    comm = (run("ps", "-o", "comm=", "-p", pid) if pid else "") or ""
    if not pid:
        add("Running", "notifications", "fail", "nobody owns org.freedesktop.Notifications")
    elif comm in ("qs", "quickshell", ".quickshell-wra"):
        add("Running", "notifications", "ok", "the shell")
    elif comm.startswith("python"):
        add("Running", "notifications", "fail", "owned by the old fabric shell (python): run install.sh update")
    else:
        add("Running", "notifications", "fail", f"owned by {comm or pid}, so the shell's cards never show (dunst, mako, swaync?)")
    registered = run("qs", "-c", "archdots", "ipc", "call", "polkit", "registered")
    if registered == "true":
        add("Running", "polkit agent", "ok", "the shell's")
    elif running("hyprpolkitagent"):
        add("Running", "polkit agent", "warn", "hyprpolkitagent (the fallback) has it, so the shell's dialog is unused")
    else:
        add("Running", "polkit agent", "fail", "none: authentication prompts cannot ask you")
    for unit in ("pipewire", "wireplumber"):
        state = run("systemctl", "--user", "is-active", unit)
        add("Running", unit, "ok" if state == "active" else "fail", state or "inactive")

    # ── config ──────────────────────────────────────────────────────────────
    if not os.path.exists(SETTINGS):
        add("Config", "settings.json", "ok", "not created yet (everything is default)")
    else:
        try:
            with open(SETTINGS, encoding="utf-8") as f:
                data = json.load(f)
            add("Config", "settings.json", "ok" if isinstance(data, dict) else "fail",
                "valid" if isinstance(data, dict) else "not a JSON object")
        except ValueError as e:
            add("Config", "settings.json", "fail", f"not valid JSON: {e}")
    try:
        with open(HYPR_LOG, encoding="utf-8") as f:
            last = f.read().strip().splitlines()[-1:]
        add("Config", "Hyprland overrides", "warn" if last else "ok", last[0] if last else "no errors logged")
    except OSError:
        add("Config", "Hyprland overrides", "ok", "no errors logged")
    for path in (".config/hypr", ".config/quickshell/archdots", ".zshrc"):
        full = os.path.join(HOME, path)
        real = os.path.realpath(full)
        if not os.path.exists(full):
            add("Config", "~/" + path, "fail", "missing: run install.sh (stow)")
        elif real.startswith(REPO_HOME + os.sep):
            add("Config", "~/" + path, "ok", "→ " + real.replace(HOME, "~"))
        else:
            add("Config", "~/" + path, "warn", "→ " + real.replace(HOME, "~") + ", not this repo's home/")

    # ── versions ────────────────────────────────────────────────────────────
    for name, cmd in (("Hyprland", ("hyprctl", "version", "-j")), ("quickshell", ("qs", "--version")), ("pywal16", ("wal", "-v"))):
        text = run(*cmd) or ""
        if name == "Hyprland" and text:
            try:
                text = json.loads(text).get("tag", text)
            except ValueError:
                pass
        add("Versions", name, "ok" if text else "warn", text.splitlines()[0] if text else "unknown")
    return out


def doctor(as_json):
    results = checks()
    if as_json:
        print(json.dumps(results))
        return 1 if any(r["status"] == "fail" for r in results) else 0
    marks = {"ok": "\033[32m✓\033[0m", "warn": "\033[33m!\033[0m", "fail": "\033[31m✗\033[0m"}
    group = None
    for r in results:
        if r["group"] != group:
            group = r["group"]
            print(f"\n{group}")
        print(f"  {marks[r['status']]} {r['name']:<30} {r['detail']}")
    fails = sum(r["status"] == "fail" for r in results)
    print(f"\n{fails} problem(s)" if fails else "\nall good")
    return 1 if fails else 0


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if args[0] == "doctor":
        return doctor("--json" in args)
    print(f"archdots: unknown command {args[0]!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
