### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-file
*.flf
#Test results file
TestResults.xml
.directory

.omc

# python
__pycache__/
*.py[cod]
.venv/

# Per-machine Hyprland overrides. config/ holds the committed defaults; these
# are loaded after them and are meant to differ on every machine, so they are
# never committed. The folder's README.md is tracked on purpose.
.config/hypr/config/custom/*.lua

# The same idea for uwsm's session environment. env-hyprland is the committed
# default and holds nothing machine-specific; uwsm sources everything in
# env-hyprland.d/ after it, and install.sh writes this machine's GPU order there.
.config/uwsm/env-hyprland.d/

# Dont include generated files in testing
archdots_docker/artifacts
