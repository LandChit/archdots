#!/usr/bin/env python3
"""simplychit — small command-line helpers for these dotfiles.

    simplychit doctor [--json]          check that everything the desktop needs
                                      is there and running, and the config
    simplychit check-settings [--json]  check settings.json against its schema:
                                      unknown keys, wrong types, bad values
    simplychit events [YYYY-MM-DD]      one day's calendar events from khal, as
                                      JSON (today if no date)

The settings app's About page shows the same checks (it runs --json).
"""

import datetime
import difflib
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
SETTINGS = os.path.join(HOME, ".config/simplychit/settings.json")
HYPR_LOG = os.path.join(HOME, ".cache/hypr-custom.log")
# This script is stowed from <repo>/home/.local/bin/, so the repo is three up.
REPO_HOME = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
# Generated from Config.qml (tools/gen-settings-schema.py).
SCHEMA = os.path.join(REPO_HOME, ".config/quickshell/simplychit/config/settings.schema.json")


def run(*cmd, timeout=3):
    """stdout (or stderr, if that is where it printed) of a command, or None
    if it is missing, fails or hangs."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (out.stdout.strip() or out.stderr.strip()) if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def running(pattern):
    return run("pgrep", "-f", pattern) is not None


def checks():
    out = []

    def add(group, name, status, detail=""):
        out.append({"group": group, "name": name, "status": status, "detail": detail})

    # ── programs ────────────────────────────────────────────────────────────
    required = {
        "Hyprland": "the compositor", "qs": "the shell (quickshell)", "hypridle": "locking before sleep",
        "hyprlock": "the lock screen fallback", "wal": "colours from the wallpaper (python-pywal16)",
        "cliphist": "clipboard history", "wl-copy": "copying", "grim": "screenshots", "slurp": "region screenshots",
        "brightnessctl": "laptop brightness", "playerctl": "media keys", "wpctl": "volume keys",
        "upower": "battery state", "nmcli": "Wi-Fi (NetworkManager)",
    }
    optional = {
        "fd": "the launcher's file search", "ddcutil": "external monitor brightness",
        "tlp": "power profiles through tlp-pd", "bluetoothctl": "pairing devices that need a passkey",
        "khal": "events in the calendar panel",
    }
    for cmd, why in required.items():
        add("Programs", cmd, "ok" if shutil.which(cmd) else "fail", why if shutil.which(cmd) else "missing: " + why)
    for cmd, why in optional.items():
        add("Programs", cmd, "ok" if shutil.which(cmd) else "warn", why if shutil.which(cmd) else "not installed (optional): " + why)

    # ── running ─────────────────────────────────────────────────────────────
    shell = run("qs", "list", "-c", "simplychit") or ""
    add("Running", "shell", "ok" if "Instance" in shell else "fail",
        "qs -c simplychit" if "Instance" in shell else "not running: SUPER+SHIFT+CTRL+ALT+R, or log in again")
    add("Running", "hypridle", "ok" if running("^hypridle") else "warn",
        "locks before sleep" if running("^hypridle") else "not running: the screen is not locked before suspend")
    add("Running", "clipboard watcher", "ok" if running("wl-paste --watch cliphist") else "warn",
        "wl-paste --watch cliphist store" if running("wl-paste --watch cliphist") else "not running: nothing new reaches the clipboard history")
    owner = run("busctl", "--user", "status", "org.freedesktop.Notifications") or ""
    pid = next((line.split("=", 1)[1] for line in owner.splitlines() if line.startswith("PID=")), "")
    comm = (run("ps", "-o", "comm=", "-p", pid) if pid else "") or ""
    if not pid:
        add("Running", "notifications", "fail", "nobody owns org.freedesktop.Notifications")
    elif comm in ("qs", "quickshell", ".quickshell-wra"):
        add("Running", "notifications", "ok", "the shell")
    elif comm.startswith("python"):
        add("Running", "notifications", "fail", "owned by the old fabric shell (python): run install.sh update")
    else:
        add("Running", "notifications", "fail", f"owned by {comm or pid}, so the shell's cards never show (dunst, mako, swaync?)")
    registered = run("qs", "-c", "simplychit", "ipc", "call", "polkit", "registered")
    if registered == "true":
        add("Running", "polkit agent", "ok", "the shell's")
    elif running("hyprpolkitagent"):
        add("Running", "polkit agent", "warn", "hyprpolkitagent (the fallback) has it, so the shell's dialog is unused")
    else:
        add("Running", "polkit agent", "fail", "none: authentication prompts cannot ask you")
    for unit in ("pipewire", "wireplumber"):
        state = run("systemctl", "--user", "is-active", unit)
        add("Running", unit, "ok" if state == "active" else "fail", state or "inactive")

    # ── config ──────────────────────────────────────────────────────────────
    if not os.path.exists(SETTINGS):
        add("Config", "settings.json", "ok", "not created yet (everything is default)")
    else:
        problems, error = settings_problems()
        if error:
            add("Config", "settings.json", "warn", f"could not check it: {error}")
        elif not problems:
            add("Config", "settings.json", "ok", "valid")
        elif problems[0].startswith("not valid JSON"):
            add("Config", "settings.json", "fail", problems[0])
        else:
            add("Config", "settings.json", "warn", f"{len(problems)} problem(s); `simplychit check-settings` lists them")
            for p in problems[:5]:
                add("Config", "  " + p.split(":")[0], "warn", p.split(":", 1)[1].strip())
    try:
        with open(HYPR_LOG, encoding="utf-8") as f:
            last = f.read().strip().splitlines()[-1:]
        add("Config", "Hyprland overrides", "warn" if last else "ok", last[0] if last else "no errors logged")
    except OSError:
        add("Config", "Hyprland overrides", "ok", "no errors logged")
    for path in (".config/hypr", ".config/quickshell/simplychit", ".zshrc"):
        full = os.path.join(HOME, path)
        real = os.path.realpath(full)
        if not os.path.exists(full):
            add("Config", "~/" + path, "fail", "missing: run install.sh (stow)")
        elif real.startswith(REPO_HOME + os.sep):
            add("Config", "~/" + path, "ok", "→ " + real.replace(HOME, "~"))
        else:
            add("Config", "~/" + path, "warn", "→ " + real.replace(HOME, "~") + ", not this repo's home/")

    # ── versions ────────────────────────────────────────────────────────────
    for name, cmd in (("Hyprland", ("hyprctl", "version", "-j")), ("quickshell", ("qs", "--version")), ("pywal16", ("wal", "-v"))):
        text = run(*cmd) or ""
        if name == "Hyprland" and text:
            try:
                text = json.loads(text).get("tag", text)
            except ValueError:
                pass
        add("Versions", name, "ok" if text else "warn", text.splitlines()[0] if text else "unknown")
    return out


# ── settings.json against its schema ────────────────────────────────────────
# Just the parts of JSON Schema the generated schema uses: type, properties,
# additionalProperties, items, enum, minimum, maximum, pattern.

KINDS = {
    "boolean": ("true or false", lambda v: isinstance(v, bool)),
    "integer": ("a whole number", lambda v: isinstance(v, int) and not isinstance(v, bool)),
    "number": ("a number", lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)),
    "string": ("text in quotes", lambda v: isinstance(v, str)),
    "array": ("a list [ ... ]", lambda v: isinstance(v, list)),
    "object": ("an object { ... }", lambda v: isinstance(v, dict)),
}


def validate(value, schema, path, problems):
    kind = schema.get("type")
    if kind and not KINDS[kind][1](value):
        problems.append(f"{path}: should be {KINDS[kind][0]}, not {json.dumps(value)}")
        return
    if "enum" in schema and value not in schema["enum"]:
        problems.append(f"{path}: {json.dumps(value)} is not one of " + ", ".join(json.dumps(e) for e in schema["enum"]))
    if "minimum" in schema and value < schema["minimum"]:
        problems.append(f"{path}: {value} is below the minimum, {schema['minimum']}")
    if "maximum" in schema and value > schema["maximum"]:
        problems.append(f"{path}: {value} is above the maximum, {schema['maximum']}")
    if "pattern" in schema and not re.search(schema["pattern"], value):
        problems.append(f"{path}: {json.dumps(value)} is not in the expected form (HH:MM)")
    if kind == "array" and "items" in schema:
        for i, item in enumerate(value):
            validate(item, schema["items"], f"{path}[{i}]", problems)
    if kind == "object":
        props = schema.get("properties", {})
        extra = schema.get("additionalProperties", True)
        for key, item in value.items():
            where = f"{path}.{key}" if path else key
            if key in props:
                validate(item, props[key], where, problems)
            elif extra is False:
                close = difflib.get_close_matches(key, props, n=1)
                problems.append(f"{where}: unknown key, ignored" + (f" (did you mean {close[0]}?)" if close else ""))
            elif isinstance(extra, dict):
                validate(item, extra, where, problems)


def settings_problems():
    """(problems, error): what is wrong with settings.json, or why it could
    not be checked at all."""
    if not os.path.exists(SETTINGS):
        return [], None
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            data = json.load(f)
    except ValueError as e:
        return [f"not valid JSON: {e}"], None
    try:
        with open(SCHEMA, encoding="utf-8") as f:
            schema = json.load(f)
    except (OSError, ValueError) as e:
        return [], f"schema not readable ({e})"
    problems = []
    validate(data, schema, "", problems)
    return problems, None


def check_settings(as_json):
    problems, error = settings_problems()
    if as_json:
        print(json.dumps({"problems": problems, "error": error}))
    elif error:
        print(f"could not check: {error}", file=sys.stderr)
    elif problems:
        print(f"{SETTINGS.replace(HOME, '~')}: {len(problems)} problem(s)")
        for p in problems:
            print(f"  {p}")
    else:
        print(f"{SETTINGS.replace(HOME, '~')}: fine")
    return 1 if problems else 0


def doctor(as_json):
    results = checks()
    if as_json:
        print(json.dumps(results))
        return 1 if any(r["status"] == "fail" for r in results) else 0
    marks = {"ok": "\033[32m✓\033[0m", "warn": "\033[33m!\033[0m", "fail": "\033[31m✗\033[0m"}
    group = None
    for r in results:
        if r["group"] != group:
            group = r["group"]
            print(f"\n{group}")
        print(f"  {marks[r['status']]} {r['name']:<30} {r['detail']}")
    fails = sum(r["status"] == "fail" for r in results)
    print(f"\n{fails} problem(s)" if fails else "\nall good")
    return 1 if fails else 0


def khal_dateformat():
    """khal parses a date only in the user's own [locale] dateformat, not ISO,
    so read that format with khal's own code (khal is Python, and the pacman
    package lives in the system site-packages). ISO if that cannot be done."""
    try:
        from khal.settings import get_config
        return get_config()["locale"]["dateformat"]
    except Exception:
        return "%Y-%m-%d"


def events(args):
    """{"available", "events", "error"}: available is false when khal is not
    installed or not set up, which the calendar shows as a hint, not an error."""
    result = {"available": False, "events": [], "error": None}
    try:
        day = datetime.date.fromisoformat(args[0]) if args else datetime.date.today()
    except ValueError:
        result["error"] = f"not a date: {args[0]!r} (YYYY-MM-DD)"
        print(json.dumps(result))
        return 2
    if not shutil.which("khal"):
        result["error"] = "khal is not installed"
        print(json.dumps(result))
        return 0
    fields = ["title", "start-time", "end-time", "all-day", "location", "calendar", "calendar-color"]
    cmd = ["khal", "list", "--once", day.strftime(khal_dateformat()), "1d"]
    for f in fields:
        cmd += ["--json", f]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        result["error"] = f"khal failed: {e}"
        print(json.dumps(result))
        return 1
    if out.returncode != 0:
        # no config file is the usual case, and khal says so on stderr
        lines = [l for l in out.stderr.splitlines() if l.strip()]
        result["error"] = lines[0].removeprefix("critical: ") if lines else f"khal exited with {out.returncode}"
        print(json.dumps(result))
        return 0
    result["available"] = True
    # one JSON array per day line; with --once and 1d there is at most one,
    # and none at all on an empty day
    for line in out.stdout.splitlines():
        line = line.strip()
        if line.startswith("["):
            for e in json.loads(line):
                result["events"].append({
                    "title": e.get("title", ""),
                    "start": e.get("start-time", ""),
                    "end": e.get("end-time", ""),
                    "allDay": e.get("all-day") == "True",
                    "location": e.get("location", ""),
                    "calendar": e.get("calendar", ""),
                    "color": e.get("calendar-color", ""),
                })
    print(json.dumps(result))
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if args[0] == "doctor":
        return doctor("--json" in args)
    if args[0] == "check-settings":
        return check_settings("--json" in args)
    if args[0] == "events":
        return events(args[1:])
    print(f"simplychit: unknown command {args[0]!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
